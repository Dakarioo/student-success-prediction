# Normalisation des fins de ligne entre Windows, macOS et Linux.
# Les fichiers texte sont stockés en LF dans le dépôt.
* text=auto

# Code, configuration et documentation : LF partout (cohérent avec .editorconfig)
*.py      text eol=lf diff=python
*.ipynb   text eol=lf
*.md      text eol=lf diff=markdown
*.json    text eol=lf
*.toml    text eol=lf
*.yml     text eol=lf
*.yaml    text eol=lf
*.txt     text eol=lf
*.cfg     text eol=lf
.gitignore      text eol=lf
.gitattributes  text eol=lf
.editorconfig   text eol=lf

# Scripts Windows : CRLF
*.ps1     text eol=crlf
*.bat     text eol=crlf
*.cmd     text eol=crlf

# Données tabulaires : aucune conversion (contenu octet pour octet)
*.csv     -text
*.tsv     -text

# Binaires
*.pdf     binary
*.png     binary
*.jpg     binary
*.jpeg    binary
*.gif     binary
*.svg     text eol=lf
*.xlsx    binary
*.pkl     binary
*.joblib  binary
*.ubj     binary
