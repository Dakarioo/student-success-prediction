# https://editorconfig.org
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.py]
indent_size = 4
max_line_length = 100

[*.ipynb]
indent_size = 1

[*.{json,yml,yaml,toml}]
indent_size = 2

[*.md]
# Deux espaces en fin de ligne peuvent forcer un retour à la ligne en Markdown.
trim_trailing_whitespace = false
indent_size = 2

[*.{ps1,bat,cmd}]
end_of_line = crlf

[*.csv]
# Les données ne sont jamais reformatées par l'éditeur.
charset = unset
end_of_line = unset
insert_final_newline = unset
trim_trailing_whitespace = unset
